NEXT_PUBLIC_SITE_URL=https://vrikshcrafts.in
PYTHON_API_URL=http://127.0.0.1:8000
APP_ENV=development

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASS=replace-me
SMTP_FROM="vrikshcrafts <no-reply@vrikshcrafts.in>"
SMTP_TO=enquiries@vrikshcrafts.in

# Optional RAG generation provider. The API key alone enables the selected free
# model. Without a key, the chatbot keeps using its local retrieval-only fallback.
OPENROUTER_API_KEY=
# Optional overrides for the production defaults shown below.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731:free
OPENROUTER_FALLBACK_MODELS=openrouter/free
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_DAILY_REQUEST_LIMIT=45

# Private passphrase for /admin/knowledge. Use at least 16 random characters.
KNOWLEDGE_ADMIN_TOKEN=
